{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@timescapenu/copilot": ["libs/copilot/src/index.ts"],
      "@timescapenu/core-api-client": ["libs/core/api-client/src/index.ts"],
      "@timescapenu/core-auth": ["libs/core/auth/src/index.ts"],
      "@timescapenu/core-guards": ["libs/core/guards/src/index.ts"],
      "@timescapenu/core-interceptors": ["libs/core/interceptors/src/index.ts"],
      "@timescapenu/core-permissions": ["libs/core/permissions/src/index.ts"],
      "@timescapenu/core-state": ["libs/core/state/src/index.ts"],
      "@timescapenu/feature-application-services": [
        "libs/features/application-services/src/index.ts"
      ],
      "@timescapenu/feature-company-specific": ["libs/features/company-specific/src/index.ts"],
      "@timescapenu/feature-compliance": ["libs/features/compliance/src/index.ts"],
      "@timescapenu/feature-corporate-lounge": ["libs/features/corporate-lounge/src/index.ts"],
      "@timescapenu/feature-ess-mss": ["libs/features/ess-mss/src/index.ts"],
      "@timescapenu/feature-home": ["libs/features/home/src/index.ts"],
      "@timescapenu/feature-hr-essentials": ["libs/features/hr-essentials/src/index.ts"],
      "@timescapenu/feature-my-sap": ["libs/features/my-sap/src/index.ts"],
      "@timescapenu/layout-breadcrumbs": ["libs/layout/breadcrumbs/src/index.ts"],
      "@timescapenu/layout-command-palette": ["libs/layout/command-palette/src/index.ts"],
      "@timescapenu/layout-mega-menu": ["libs/layout/mega-menu/src/index.ts"],
      "@timescapenu/layout-module-bar": ["libs/layout/module-bar/src/index.ts"],
      "@timescapenu/layout-sidebar": ["libs/layout/sidebar/src/index.ts"],
      "@timescapenu/shared-i18n": ["libs/shared/i18n/src/index.ts"],
      "@timescapenu/shared-models": ["libs/shared/models/src/index.ts"],
      "@timescapenu/shared-patterns": ["libs/shared/patterns/src/index.ts"],
      "@timescapenu/shared-tokens": ["libs/shared/tokens/src/index.ts"],
      "@timescapenu/shared-ui": ["libs/shared/ui/src/index.ts"],
      "@timescapenu/testing": ["libs/testing/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
